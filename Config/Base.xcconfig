// Single source of truth for per-app identity and version. Scripts and Xcode both read this file.
// Override locally (never committed) in Config/Local.xcconfig -- see Local.xcconfig.example.
// Set DEVELOPMENT_TEAM in Config/Local.xcconfig (gitignored). Keys live outside git (docs/signing.md).

APP_NAME = PocketPalette
DISPLAY_NAME = PocketPalette
PRODUCT_BUNDLE_IDENTIFIER = com.trillium.pocketpalette

// Version is derived from git tags, never hand-edited (docs/versioning.md). These are only fallbacks for a
// checkout with no git history; `make generate` writes Config/Version.xcconfig (gitignored), which overrides them.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1
#include? "Version.xcconfig"

// Feed host:port the app is prefilled with (Info.plist PaletteServerURL = http://$(PALETTE_SERVER_HOST)).
// Set it in the gitignored Config/Local.xcconfig, never here. Empty = the app starts "Not set up".
PALETTE_SERVER_HOST =

#include? "Local.xcconfig"
