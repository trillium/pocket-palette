// Single source of truth for per-app identity and version. Scripts and Xcode both read this file.
// Override locally (never committed) in Config/Local.xcconfig -- see Local.xcconfig.example.
// Set DEVELOPMENT_TEAM in Config/Local.xcconfig (gitignored). Keys live outside git (docs/signing.md).

APP_NAME = PocketPalette
DISPLAY_NAME = PocketPalette
PRODUCT_BUNDLE_IDENTIFIER = com.trillium.pocketpalette
// The App Group the app and its widget share (entitlements, and PaletteAppGroup in both Info.plists), and the URL scheme
// the widget opens the app with. Beta overrides both (Config/Beta.xcconfig). If Local.xcconfig changes the bundle id,
// change APP_GROUP_ID to group.<that id> there too.
APP_GROUP_ID = group.com.trillium.pocketpalette
PALETTE_URL_SCHEME = pocketpalette

// Version is derived from git tags, never hand-edited (docs/versioning.md). These are only fallbacks for a
// checkout with no git history; `make generate` writes Config/Version.xcconfig (gitignored), which overrides them.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1
#include? "Version.xcconfig"

// Feed host:port the app is prefilled with (Info.plist PaletteServerURL = http://$(PALETTE_SERVER_HOST)).
// Set it in the gitignored Config/Local.xcconfig, never here. Empty = the app starts "Not set up".
PALETTE_SERVER_HOST =

// Minimum-good-version check: the app reads this small file at launch and each time it comes to the front, and shows a
// "broken build" screen if its own build is below the minimum or listed as broken. It fails open: an unreachable file never
// blocks the app. Empty disables the check. "//" starts an xcconfig comment, so the URL's slashes are split with $().
// The host serving it is set per machine: SIDE_HOST in the gitignored Config/Local.xcconfig (see Local.xcconfig.example). The same
// setting feeds the App Transport Security exception in Info.plist. The placeholder default is unreachable, which fails open.
SIDE_HOST = example.ts.net
MIN_VERSION_URL = http:/$()/$(SIDE_HOST):4380/min-version.json

#include? "Local.xcconfig"
